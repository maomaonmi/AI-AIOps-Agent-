{
  "name": "ai-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 文件助手桌面端新项目",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "electron:dev": "concurrently -k \"vite\" \"npm run build:electron -- --watch\" \"wait-on http://localhost:5173 && electron .\"",
    "build:electron": "tsc -p tsconfig.node.json",
    "electron:build": "npm run build && npm run build:electron && electron-builder"
  },
  "dependencies": {
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pptxjs": "^0.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.0.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.1"
  }
}
